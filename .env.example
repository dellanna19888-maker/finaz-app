# Anthropic API-Key – nur für KI-Assistent & Notizen nötig (https://platform.claude.com)
ANTHROPIC_API_KEY=sk-ant-...

# Optional: Claude-Modell (Standard: claude-opus-4-8)
CLAUDE_MODEL=claude-opus-4-8

# Optional: Port des API-Servers (Standard: 3001) – muss zum Vite-Proxy passen
API_PORT=3001

# --- Compliance-Gateway (optional) ---
# Profil erzwingen (EU | UK | US | DEFAULT), überschreibt die GEO-Erkennung
# COMPLIANCE_FORCE_JURISDICTION=EU
# Maximale Zeichenzahl pro Anfrage (Datenminimierung)
# COMPLIANCE_MAX_CHARS=50000
# Verzeichnis für Audit-Logs (Standard: server/logs)
# COMPLIANCE_LOG_DIR=
# Echte GeoIP-Auflösung der Client-IP (Paket geoip-lite, lädt ~150 MB in den RAM):
# standardmäßig AUS. Auf kleinen Instanzen (z. B. Render Free, 512 MB) besser aus
# lassen – CDN-Header bzw. das DEFAULT-Profil (DSGVO) greifen weiterhin. Einschalten:
# ENABLE_GEOIP=1
