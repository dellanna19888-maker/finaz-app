# Anthropic API-Key – PFLICHT. Hol dir einen unter https://platform.claude.com
ANTHROPIC_API_KEY=sk-ant-...

# Optional: zu verwendendes Claude-Modell (Standard: claude-opus-4-8)
CLAUDE_MODEL=claude-opus-4-8

# Optional: Server-Port (Standard: 3000)
PORT=3000

# --- Compliance-Gateway (D-C-G), alle optional ---
# Erzwingt ein Profil (EU | UK | US | DEFAULT) und überschreibt die GEO-Erkennung.
# COMPLIANCE_FORCE_JURISDICTION=EU
# Maximale Zeichenzahl pro Anfrage (Datenminimierung), Standard 50000.
# COMPLIANCE_MAX_CHARS=50000
# Verzeichnis für Audit-Logs (Standard: compliance/logs).
# COMPLIANCE_LOG_DIR=
