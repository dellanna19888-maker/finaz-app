{
  "name": "finaz-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "api": "tsx server/index.ts",
    "api:dev": "tsx watch server/index.ts",
    "dev:all": "concurrently -k -n web,api -c blue,green \"npm:dev\" \"npm:api:dev\"",
    "demo": "npm run build && npm run api"
  },
  "dependencies": {
    "@anthropic-ai/sdk": ">=0.40.0",
    "@vueuse/core": "^14.3.0",
    "chart.js": "^4.5.1",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "marked": "^12.0.0",
    "pinia": "^3.0.4",
    "vue": "^3.5.34",
    "vue-chartjs": "^5.3.3",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.12.3",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/tsconfig": "^0.9.1",
    "concurrently": "^9.1.0",
    "tsx": "^4.19.0",
    "typescript": "~6.0.2",
    "vite": "^8.0.12",
    "vue-tsc": "^3.2.8"
  }
}
